# ─────────────  عمومی  ─────────────
NODE_ENV=development
APP_NAME="پاسارگاد میزبان"
APP_URL=http://localhost:3000

# ─────────────  دیتابیس  ─────────────
# PostgreSQL 14 به بالا
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/pasargad_cloud?schema=public"

# ─────────────  امنیت  ─────────────
# حداقل ۳۲ کاراکتر تصادفی — با دستور زیر بسازید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# دقیقاً ۶۴ کاراکتر هگز (۳۲ بایت) — برای رمزنگاری پسورد روت سرورها
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

SESSION_COOKIE=pm_session
SESSION_DAYS=30

# توکن محافظ برای فراخوانی endpoint های زمان‌بندی از بیرون (اختیاری)
CRON_SECRET=""

# ─────────────  هتزنر کلاد  ─────────────
# از Hetzner Cloud Console → Project → Security → API Tokens (دسترسی Read & Write)
# اختیاری و فقط برای مهاجرت از نسخه‌های قدیمی؛ توکن‌ها را از پنل مدیریت،
# بخش «حساب‌های هتزنر» اضافه کنید تا رمزنگاری‌شده در دیتابیس ذخیره شوند.
HETZNER_API_TOKEN=""
HETZNER_API_URL=https://api.hetzner.cloud/v1

# ─────────────  سرویس آزمایش دسترسی از ایران  ─────────────
# فایل scripts/iran-probe-agent.mjs را روی یکی از سرورهای ایرانی خودتان اجرا کنید
# و آدرس و کلید آن را اینجا بگذارید. بدون این دو مقدار، بررسی خودکار آدرس‌ها
# انجام نمی‌شود و مشتری ممکن است سروری با آی‌پی مسدود تحویل بگیرد.
IRAN_PROBE_URL=
IRAN_PROBE_SECRET=

# ─────────────  درگاه پرداخت زیبال  ─────────────
# مقدار zibal یعنی حالت تست (سندباکس)
ZIBAL_MERCHANT=zibal
ZIBAL_API_URL=https://gateway.zibal.ir

# ─────────────  ربات تلگرام  ─────────────
# توکن را از @BotFather بگیرید
TELEGRAM_BOT_TOKEN=
# فقط اگر از webhook استفاده می‌کنید (به جای long polling)
TELEGRAM_WEBHOOK_SECRET=
# اگر سرور به api.telegram.org دسترسی مستقیم ندارد، آدرس پروکسی را اینجا بگذارید
TELEGRAM_API_URL=https://api.telegram.org

# ─────────────  ایمیل (اختیاری)  ─────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=no-reply@pasargadmizban.ir

# ─────────────  پیامک (اختیاری)  ─────────────
# kavenegar یا sms_ir
SMS_PROVIDER=kavenegar
SMS_API_KEY=""
SMS_SENDER=""
